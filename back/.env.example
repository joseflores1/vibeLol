# Backend environment configuration. Copy to .env and fill in real values.
# Never commit .env. Never hardcode RIOT_API_KEY in code.

# Express
PORT=3000
NODE_ENV=development

# Postgres connection string (credentials must match root .env)
DATABASE_URL="postgresql://viblol:change-me@localhost:5432/viblol?schema=public"

# Riot Games API — get a key at https://developer.riotgames.com/
RIOT_API_KEY=your-riot-api-key-here

# Riot client protection. Development-key defaults: 20 requests per 100s,
# retry transient failures up to 3 times.
RIOT_RATE_LIMIT_PER_100S=20
RIOT_MAX_RETRIES=3
